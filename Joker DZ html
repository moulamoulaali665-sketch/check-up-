<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Joker RAM Stress Test v2</title>
    <style>
        body {
            background-color: #050505;
            color: #00ff00;
            font-family: 'Courier New', monospace;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            height: 100vh;
            margin: 0;
            overflow: hidden;
        }
        #status {
            font-size: 1.5rem;
            text-shadow: 0 0 10px #00ff00;
            margin-bottom: 20px;
        }
        #logs {
            width: 80%;
            height: 200px;
            border: 1px solid #333;
            padding: 10px;
            overflow-y: auto;
            background: rgba(0, 255, 0, 0.05);
            font-size: 0.8rem;
        }
        .btn {
            background: transparent;
            color: #00ff00;
            border: 1px solid #00ff00;
            padding: 10px 20px;
            cursor: pointer;
            margin-top: 20px;
        }
        .btn:hover { background: #00ff00; color: black; }
    </style>
</head>
<body>

    <div id="status">JOKER SYSTEM STRESS: IDLE</div>
    <div id="logs">Ready to start stress test...</div>
    <button class="btn" onclick="startTest()">START STRESS TEST</button>

    <script>
        let memoryFill = [];
        const logs = document.getElementById('logs');
        const status = document.getElementById('status');

        function addLog(message) {
            const div = document.createElement('div');
            div.textContent = `[${new Date().toLocaleTimeString()}] ${message}`;
            logs.appendChild(div);
            logs.scrollTop = logs.scrollHeight;
        }

        function startTest() {
            status.textContent = "STATUS: RUNNING...";
            status.style.color = "red";
            addLog("Warning: RAM allocation started.");

            // تكرار استهلاك الذاكرة
            setInterval(() => {
                try {
                    // إنشاء مصفوفة ضخمة (حوالي 8 ميجابايت في كل مرة)
                    let buffer = new Float64Array(1024 * 1024); 
                    for (let i = 0; i < buffer.length; i++) {
                        buffer[i] = Math.random();
                    }
                    memoryFill.push(buffer);
                    addLog(`Allocated: ${memoryFill.length * 8}MB total`);
                } catch (e) {
                    addLog("Memory Full or Browser Throttled.");
                }
            }, 100);
        }
    </script>
</body>
</html>

