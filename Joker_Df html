<!DOCTYPE html>
<html lang="ar">
<head>
    <meta charset="UTF-8">
    <title>Advanced Stress Test - Pro</title>
    <style>
        body { background: #1a1a1a; color: #00ff00; font-family: 'Courier New', monospace; text-align: center; padding: 20px; }
        .container { border: 2px solid #00ff00; padding: 20px; border-radius: 15px; display: inline-block; }
        button { background: #f00; color: #fff; border: none; padding: 15px 30px; font-size: 18px; cursor: pointer; border-radius: 5px; font-weight: bold; }
        button:hover { background: #b00; }
        .stat-box { margin: 20px; font-size: 24px; color: #00d4ff; }
        #log { font-size: 14px; color: #888; height: 100px; overflow: hidden; }
    </style>
</head>
<body>
    <div class="container">
        <h1>إختبار الجهد الأقصى (RAM/CPU)</h1>
        <div id="status" class="stat-box">الحالة: مستعد</div>
        <div id="ram-val" style="font-size: 40px; margin-bottom: 10px;">0 MB</div>
        <button id="startBtn" onclick="runSmartTest()">ابدأ الاختبار الشامل</button>
        <div id="log"></div>
    </div>

    <script>
        let memoryStore = [];
        let isRunning = false;

        function log(msg) {
            const l = document.getElementById('log');
            l.innerHTML = msg + "<br>" + l.innerHTML;
        }

        // دالة لاستهلاك المعالج بشكل ذكي (بدون تجميد المتصفح)
        function cpuHeavyTask() {
            if (!isRunning) return;
            
            let start = Date.now();
            // تشغيل معالجة رياضية لمدة 100 ميللي ثانية في كل دورة
            while (Date.now() - start < 100) {
                Math.atan(Math.random()) * Math.pow(Math.random(), 5);
            }
            
            // استخدام setTimeout يسمح للمتصفح بالتنفس وتحديث الواجهة
            setTimeout(cpuHeavyTask, 0);
        }

        function runSmartTest() {
            if(isRunning) return;
            isRunning = true;
            document.getElementById('status').innerText = "جاري الضغط على النظام...";
            document.getElementById('startBtn').style.display = 'none';

            // 1. الضغط على الرام (زيادة تدريجية لتجنب الإغلاق الفوري)
            setInterval(() => {
                try {
                    // إضافة 50 ميجابايت في كل ثانية
                    for(let i=0; i<50; i++) {
                        let buffer = new Uint8Array(1024 * 1024); // 1MB
                        for(let j=0; j<buffer.length; j+=1024) buffer[j] = j; // إجبار النظام على حجز المساحة فعلياً
                        memoryStore.push(buffer);
                    }
                    let total = memoryStore.length;
                    document.getElementById('ram-val').innerText = total + " MB";
                    log("تم حجز " + total + " ميجابايت من الرام...");
                } catch (e) {
                    log("وصلت الرام للحد الأقصى المسموح!");
                }
            }, 1000);

            // 2. الضغط على المعالج (تشغيل 4 خيوط وهمية)
            for(let i=0; i<4; i++) {
                cpuHeavyTask();
            }
        }
    </script>
</body>
</html>
